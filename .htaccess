# =============================================================
# mofo.ws — site estático (go-live nov/2026) · HostGator / Apache
# =============================================================
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# --- HTTPS e domínio sem www ---------------------------------
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://mofo.ws/$1 [R=301,L]

# --- index.html no endereço vira a pasta ----------------------
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /%1 [R=301,L]

# --- Páginas do site antigo que mudaram de endereço ----------
RewriteRule ^escritorios-privativos/?$ /privativos/ [R=301,L]
RewriteRule ^estudio-multimidia/?$ /estudio/ [R=301,L]
RewriteRule ^portal/?$ /unidades/portal/ [R=301,L]
RewriteRule ^slot-fixo/?$ /sala-recorrente/ [R=301,L]
RewriteRule ^endereco-fiscal-sua-empresa-de-casa-nova(-2)?/?$ /endereco-fiscal/ [R=301,L]
RewriteRule ^quillforms/torne-se-membro/?$ /coworking/ [R=301,L]
RewriteRule ^(aniversario|blacknovember-2024|blacknovember2022|coworkingweek)/?$ / [R=301,L]

# --- Conteúdo de demonstração do tema antigo: removido (410) --
RewriteRule ^(project|project_category|partner|partner_category|event|member|tag|category|elementor-hf|quillforms|slider)(/.*)?$ - [G,L]
RewriteRule ^(hello-world|hello-world-2|playmatch-to-inspire-and-motivate-yourself|more-matches-gives-good-services|outdoor-games-to-play-in-ground|make-good-team-to-play-our-matches|here-are-the-5-most-telling-signs-of-micromanagement|instagram-feed-add-to-your-wordpress-site|use-the-web-for-a-day-on-a-50-mb-budget|how-to-become-a-successful-businessman|many-important-brands-have-given-us-their-trust|why-details-matter-in-your-workspace|creative-offices-options-that-boost-productivity|management-in-a-brave-new-virtual-world)/?$ - [G,L]
RewriteCond %{QUERY_STRING} (^|&)wpr_templates= [NC]
RewriteRule ^ - [G,L]
RewriteRule ^(feed|comments/feed|sitemap_index\.xml|wp-sitemap\.xml|sitemap\.rss)/?$ /sitemap.xml [R=301,L]
</IfModule>

# --- Compressão ----------------------------------------------
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json image/svg+xml application/manifest+json
</IfModule>

# --- Cache do navegador --------------------------------------
<IfModule mod_expires.c>
ExpiresActive On
ExpiresDefault "access plus 1 week"
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType image/jpeg "access plus 6 months"
ExpiresByType image/png "access plus 6 months"
ExpiresByType image/webp "access plus 6 months"
ExpiresByType image/svg+xml "access plus 6 months"
ExpiresByType image/x-icon "access plus 6 months"
ExpiresByType video/mp4 "access plus 6 months"
ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

AddType image/webp .webp
AddType application/manifest+json .webmanifest
AddType text/plain .txt
